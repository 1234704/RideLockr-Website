<script>
  console.log("RideLockr Loaded");

  const toggleTrack = document.getElementById("toggleTrack");
  const monthlyLabel = document.getElementById("monthlyLabel");
  const yearlyLabel = document.getElementById("yearlyLabel");

  let yearly = false;

  toggleTrack.addEventListener("click", () => {

    yearly = !yearly;

    toggleTrack.classList.toggle("on");

    monthlyLabel.classList.toggle("active");
    yearlyLabel.classList.toggle("active");

    document.querySelectorAll(".price-amount").forEach(price => {

      const monthlyPrice = price.dataset.monthly;
      const yearlyPrice = price.dataset.yearly;

      price.textContent = yearly ? yearlyPrice : monthlyPrice;

    });

  });
</script>


